.env
.env.*
!.env.example

# Local SQLite databases
backend/*.db
backend/*.sqlite
backend/*.sqlite3

# Flutter / Dart (also see flutter_debate_arena/.gitignore)
**/.dart_tool/
**/.flutter-plugins
**/.flutter-plugins-dependencies
**/.packages
**/.pub-cache/
**/.pub/
**/build/
**/coverage/
*.apk
*.aab
